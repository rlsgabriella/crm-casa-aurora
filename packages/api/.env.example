# Banco de dados — Supabase (mesmo do Casa Aurora)
DATABASE_URL="postgresql://postgres:SENHA@db.PROJETO.supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:SENHA@db.PROJETO.supabase.co:5432/postgres"

# Clerk (app separado do Casa Aurora — criar em clerk.com)
CLERK_SECRET_KEY="sk_live_..."
CLERK_PUBLISHABLE_KEY="pk_live_..."

# Resend — envio de e-mails (opcional)
RESEND_API_KEY="re_..."

# WAHA — WhatsApp API (Docker do Casa Aurora)
WAHA_API_URL="http://localhost:3000"
WAHA_API_KEY=""

# n8n — automação (Docker do Casa Aurora)
N8N_WEBHOOK_URL="http://localhost:5678/webhook"

# Multi-tenant: ID do restaurante padrão (obter após prisma db push + seed)
DEFAULT_RESTAURANTE_ID="id-do-restaurante-no-banco"

PORT=3334
